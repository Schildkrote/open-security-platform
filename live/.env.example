# live/.env.example — template for the local proof stack credentials.
#
# NEVER COMMIT REAL VALUES. Copy this file to live/.env (or run
# `make env` in live/, which generates strong random values for every
# placeholder below) and keep .env out of git — live/.gitignore already
# excludes it. All services bind to 127.0.0.1 only; these credentials are
# for the local Docker proof stack and nothing else.

# --- Keycloak ---------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE…only
# Realm imported at first start from live/keycloak/osp-realm.json
KEYCLOAK_REALM=osp

# --- Wazuh -------------------------------------------------------------------
# Indexer credentials MUST match the bcrypt hash baked into the upstream
# internal_users.yml demo config (admin / SecretPassword) that
# scripts/fetch-wazuh-config.sh pins. Do NOT change these unless you
# regenerate the hash — the manager's filebeat ships alerts to the indexer
# with them, and the indexer healthcheck authenticates with them.
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=SecretPassword
# Manager REST API user, created by the manager image's init script from
# these vars. Wazuh enforces 8-64 chars with upper, lower, digit and symbol.
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=CHANGE…_Me1

# --- DefectDojo ---------------------------------------------------------------
DD_ADMIN_USER=admin
DD_ADMIN_PASSWORD=CHANGE…only
DD_DATABASE_USER=defectdojo
DD_DATABASE_PASSWORD=CHANGE…only
# Django secret key (any long random string).
DD_SECRET_KEY=CHANGE…ters
# AES-256 key for tool-configuration credentials — must be exactly 32 chars.
DD_CREDENTIAL_AES_256_KEY=CHANGE…32_chars_long_

# --- OpenBao -------------------------------------------------------------------
# Root token for the dev-mode server (BAO_DEV_ROOT_TOKEN_ID).
BAO_ROOT_TOKEN=CHANGE…oken

# --- Ollama --------------------------------------------------------------------
# Tiny model the AI-gateway proof pulls and round-trips (small download).
OLLAMA_MODEL=smollm2:135m
